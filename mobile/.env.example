# Nodus Mobile — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus dados do Supabase
# No Expo, variáveis públicas devem começar com EXPO_PUBLIC_

# Supabase Project URL
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase Anon Key (Public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica-aqui
